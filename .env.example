# Copiar a .env (nunca subir .env al repo).
# Usado por Netlify Functions y por scripts/permisos-local-proxy.*

# Token compartido con Google Apps Script (Properties → API_TOKEN)
API_TOKEN=

# Web App /exec — Pases de salida
PERMISOS_SCRIPT_URL=

# Web App /exec — Tarjeta Pallet (aliases aceptados por la función)
TARJETAS_SCRIPT_URL=
# APPS_SCRIPT_URL=
# TARJETAS_API_URL=

# Opcional: tokens específicos
# PERMISOS_API_TOKEN=
# TARJETAS_API_TOKEN=

# Proxy local (scripts/permisos-local-proxy.mjs)
PERMISOS_PROXY_PORT=8787
