# Copia a .env solo para pruebas locales (NO subir .env al repo).
# En Netlify usa Environment variables del sitio.

# Mismo valor que Apps Script → Propiedades del script → API_TOKEN
API_TOKEN=

# URL …/exec del Web App de permisos (BD-PERMISOS)
# Pégala solo en .env / Netlify — no en archivos del repositorio
PERMISOS_SCRIPT_URL=

# URL …/exec del Web App de Tarjeta Pallet (sheet exclusivo)
# Vive en el sitio https://qpack.netlify.app (env APPS_SCRIPT_URL + mismo API_TOKEN).
# El panel shell NO necesita esta variable si consume el proxy remoto de qpack.
TARJETAS_SCRIPT_URL=
# APPS_SCRIPT_URL=
